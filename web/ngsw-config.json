{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/logo-mwana-classe.png",
          "/*.css",
          "/*.js",
          "/*.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/assets/**",
          "/*.(svg|png|jpg|jpeg|webp|woff|woff2|ttf|eot)"
        ]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*/**"]
}
