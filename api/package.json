{
  "name": "mwana-classe-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "API sécurisée MwanaClasse — gestion scolaire et suivi parent-enfant",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "secrets:generate": "node dist/tools/generate-secrets.js",
    "security:selftest": "node dist/tools/security-selftest.js",
    "db:migrate": "node dist/tools/migrate.js",
    "db:seed": "node dist/tools/seed.js",
    "db:verify": "node dist/tools/verify-db.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.2.0",
    "argon2": "^0.43.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "jszip": "^3.10.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "typescript": "~5.9.2"
  }
}
