# ============================================================================
#  MWANA CLASSE — Configuration de l'API (modèle)
# ============================================================================
#  Utilisation :
#    cp .env.example .env      (puis complétez les valeurs)
#
#  Toute valeur manquante ou dangereuse en production fait REFUSER le
#  démarrage du serveur (fail closed).
#  Les secrets se génèrent avec :  npm run secrets:generate
# ============================================================================

# ------------------------------------------------------------------
#  Application
# ------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Production: URL publique HTTPS de votre hébergement API
API_PUBLIC_URL=http://localhost:4000
# Production: URL Vercel du frontend
WEB_PUBLIC_URL=http://localhost:4200
# Origines autorisées pour CORS (séparées par des virgules, jamais * en prod)
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
# true derrière le reverse proxy de votre hébergeur
TRUST_PROXY=false

# ------------------------------------------------------------------
#  Base de données
# ------------------------------------------------------------------
# Supabase Transaction Pooler (remplacez [YOUR-PASSWORD], sans les crochets)
DATABASE_URL=postgresql://postgres.pgzibzjllcwhzaaqqbhh:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=true
# Le pooler Supabase (6543) présente un certificat auto-signé dans sa chaîne :
# la vérification strictement refusée casserait les connexions (SELF_SIGNED_CERT_IN_CHAIN).
DB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------
#  Secrets  (générer avec « npm run secrets:generate »)
#  Chaque valeur doit faire au moins 32 octets.
#  EN PRODUCTION : MWANA_PEPPER_PASSWORD, MWANA_KEY_DATA, MWANA_KEY_AUDIT
#  et MWANA_KEY_TOKENS sont OBLIGATOIRES.
# ------------------------------------------------------------------
MWANA_SECRET_PROVIDER=env
# MWANA_SECRETS_DIR=/run/secrets          # mode « file » (Docker/Kubernetes secrets)
# MWANA_PEPPER_PASSWORD=
# MWANA_KEY_DATA=
# MWANA_KEY_AUDIT=
# MWANA_KEY_TOKENS=
# MWANA_KEY_TOTP=
# MWANA_KEY_DOCUMENTS=

# ------------------------------------------------------------------
#  Sessions et jetons
# ------------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_DAYS=90
# COOKIE_DOMAIN=exemple.cd
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Supabase project URL (optionnel, pour référence/intégrations)
SUPABASE_PROJECT_URL=https://pgzibzjllcwhzaaqqbhh.supabase.co
# Supabase project reference (documentation/configuration only)
SUPABASE_PROJECT_URL=https://pgzibzjllcwhzaaqqbhh.supabase.co

# ------------------------------------------------------------------
#  Anti-bruteforce
# ------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
CODE_LOOKUP_PER_HOUR=40

# ------------------------------------------------------------------
#  Deuxième facteur (TOTP)
# ------------------------------------------------------------------
REQUIRE_2FA_STAFF=false
REQUIRE_2FA_DIRECTOR=true
TOTP_ISSUER=MwanaClasse
TOTP_MAX_ATTEMPTS=6

# ------------------------------------------------------------------
#  Divers
# ------------------------------------------------------------------
MAX_UPLOAD_MB=20
APP_DEFAULT_LOCALE=fr-CD
APP_TIMEZONE=Africa/Kinshasa
# Jeu de démonstration (JAMAIS en production)
SEED_DEMO_DATA=false
